---
// src/pages/index.astro
// 在这里配置你的文件，外观会和第一版自动扫描的一样
const files = [
  "MaaEnd-win-x86_64-v2.7.0.zip",
  // 你以后有新文件，只需要在这里加文件名，一行一个
  // "app-new.apk",
  // "music.flac",
];

// 链接映射：把文件名对应到你的 GitHub Release 直链
function getDownloadUrl(filename) {
  const baseUrl = "https://github.com/LegspCpd/files-01.github.io/releases/download/end/";
  return baseUrl + encodeURIComponent(filename);
}
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>文件下载</title>
</head>
<body>
  <h1>文件列表</h1>
  ${files.length === 0 
    ? '<p>当前目录没有找到符合条件的文件。</p>' 
    : '<ul>' + files.map(file => 
        `<li><a href="${getDownloadUrl(file)}" download="${file}">${file}</a></li>`
      ).join('') + '</ul>'
  }
</body>
</html>